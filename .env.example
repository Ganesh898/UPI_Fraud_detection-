# ==========================================
# UPI Shield - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=upishield_super_secret_jwt_key_2026_hackathon_secure
JWT_EXPIRES_IN=7d

# Database Configuration (SQLite)
DB_PATH=../database/upishield.sqlite

# Fraud Engine Configuration
ENABLE_OCR=true
SIMULATED_DELAY_MS=600
MAX_UPLOAD_SIZE_MB=5

# Demo Mode Indicator
DEMO_MODE=true
NPCI_SIMULATION_ACTIVE=true
